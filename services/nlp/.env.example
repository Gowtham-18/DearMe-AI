PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Shared secret: the web app sends it as X-Internal-Token. Set the same value in Vercel.
# Leave empty for local development only (POST endpoints are then open).
NLP_INTERNAL_TOKEN=

# Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMOTION_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base
# emotion (default, sentiment derived from the emotion model) | transformer (adds SST-2, ~260 MB) | vader
SENTIMENT_SOURCE=emotion
SENTIMENT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
# true = skip the emotion transformer (lexicon emotion + VADER), for instances under ~700 MB RAM
NLP_LOW_MEMORY=false
TORCH_NUM_THREADS=1
TRANSFORMERS_NO_TF=1
TRANSFORMERS_NO_FLAX=1

# Request limits
MAX_TEXT_LENGTH=400
MAX_ANALYZE_CHARS=6000
MAX_ENTRIES_PER_REQUEST=12
MAX_THEME_ENTRIES=200

# Optional LLM wording (only used for users who opt in under Settings)
ENABLE_ENHANCED_LANGUAGE=true
ENABLE_OPENAI_CUES=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=220
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_S=8
OPENAI_DAILY_LIMIT_PER_USER=80
OPENAI_DAILY_LIMIT=3000
