PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Shared secret: the web app sends it as X-Internal-Token. Set the same value in Vercel.
# Leave empty for local development only (POST endpoints are then open).
NLP_INTERNAL_TOKEN=

# Models (ONNX Runtime; pinned revisions live in app/pipeline.py)
# Downloaded to NLP_MODEL_DIR (default services/nlp/.models) by `python -m app.fetch_models`,
# or on first load if that step was skipped.
# NLP_MODEL_DIR=
# emotion (default, sentiment derived from the emotion model) | vader
SENTIMENT_SOURCE=emotion
# true = skip the emotion model (lexicon emotion + VADER), saves ~100 MB
NLP_LOW_MEMORY=false
NLP_THREADS=1

# Request limits
MAX_TEXT_LENGTH=400
MAX_ANALYZE_CHARS=6000
MAX_ENTRIES_PER_REQUEST=12
MAX_THEME_ENTRIES=200

# Optional LLM wording (only used for users who opt in under Settings)
ENABLE_ENHANCED_LANGUAGE=true
ENABLE_OPENAI_CUES=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=220
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_S=8
OPENAI_DAILY_LIMIT_PER_USER=80
OPENAI_DAILY_LIMIT=3000
